---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import homepage from '../data/homepage.json';
import { bnDate, catName } from '../lib/utils';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byId = new Map(posts.map((p) => [p.id, p]));
const norm = (v: string) => v.replace(/^.*\//, '').replace(/\.md$/, '');
const pick = (v: string) => byId.get(norm(v));

const lead = (homepage.lead ? pick(homepage.lead) : undefined) ?? posts[0];
const breaking = (homepage.breaking ?? []).map(pick).filter((p) => p && p.id !== lead.id);
const heroCards = (homepage.heroCards ?? []).map(pick).filter(Boolean).slice(0, 4);
const heroText = (homepage.heroText ?? []).map(pick).filter(Boolean).slice(0, 3);
const railVideo = homepage.railVideo ? pick(homepage.railVideo) : undefined;
const opinion = (homepage.opinion ?? []).map(pick).filter(Boolean).slice(0, 3);

const limits: Record<string, number> = { split: 5, cards3: 3, cards4: 4, video: 5, shorts: 6, district: 5 };

const sections = (homepage.sections ?? [])
  .map((s: any) => {
    if (s.layout === 'cols') {
      const columns = (s.columns ?? [])
        .map((c: any) => ({
          title: c.title,
          items: (c.items ?? []).map(pick).filter(Boolean).slice(0, 4),
        }))
        .filter((c: any) => c.items.length > 0);
      return { ...s, items: columns.flatMap((c: any) => c.items), columns };
    }
    const manual = (s.items ?? []).map(pick).filter(Boolean);
    const auto = s.category ? posts.filter((p) => p.data.category === s.category) : [];
    const merged = manual.length ? manual : auto;
    const unique = merged.filter((p, i, arr) => arr.findIndex((x) => x.id === p.id) === i);
    const limit = limits[s.layout] ?? 3;
    // top up so every block looks full, like a printed page
    const filled = [...unique];
    for (const p of posts) {
      if (filled.length >= limit) break;
      if (!filled.some((x) => x.id === p.id)) filled.push(p);
    }
    return { ...s, items: filled.slice(0, limit) };
  })
  .filter((s) => s.items.length > 0);
---

<Base>
  <div class="container">
    <div class="hero">
      <div class="hero-main">
        <div class="hero-top">
          <article class="hero-lead">
            <span class="kicker">প্রথম পাতা</span>
            <h1 class="lead-title"><a href={`/news/${lead.id}/`}>{lead.data.title}</a></h1>
            {lead.data.dek && <p class="lead-dek">{lead.data.dek}</p>}
            {lead.data.image && (
              <a href={`/news/${lead.id}/`}>
                <img
                  class="lead-img"
                  src={lead.data.image}
                  alt={lead.data.imageAlt ?? lead.data.title}
                  width="800"
                  height="450"
                  loading="eager"
                />
              </a>
            )}
          </article>

          <aside class="breaking">
            <h3>সর্বশেষ</h3>
            <ul>
              {breaking.map((p) => (
                <li>
                  <a href={`/news/${p.id}/`}>{p.data.title}</a>
                  {p.data.image && (
                    <img src={p.data.image} alt="" width="88" height="62" loading="lazy" />
                  )}
                </li>
              ))}
            </ul>
          </aside>
        </div>

        <div class="cards4">
          {heroCards.map((p) => (
            <article>
              <a href={`/news/${p.id}/`}>
                {p.data.image && (
                  <img src={p.data.image} alt={p.data.imageAlt ?? p.data.title} width="300" height="225" loading="lazy" />
                )}
                <h4>{p.data.title}</h4>
              </a>
            </article>
          ))}
        </div>

        <div class="headlines3">
          {heroText.map((p) => (
            <article>
              <a href={`/news/${p.id}/`}>{p.data.title}</a>
              <div class="meta-row">{catName(p.data.category)} · {bnDate(p.data.date)}</div>
            </article>
          ))}
        </div>
      </div>

      <aside class="hero-rail">
        {railVideo && (
          <div class="video-card">
            <a href={`/news/${railVideo.id}/`} style="position:relative;display:block">
              {railVideo.data.image && (
                <img src={railVideo.data.image} alt={railVideo.data.imageAlt ?? railVideo.data.title} width="336" height="189" />
              )}
              <span class="play-badge"><span>▶</span></span>
            </a>
            <h4><a href={`/news/${railVideo.id}/`}>{railVideo.data.title}</a></h4>
          </div>
        )}
        <a class="ad-slot" href="/contact/">
          বিজ্ঞাপনের জন্য যোগাযোগ করুন
          <small>৩০০ × ২৫০</small>
        </a>
      </aside>
    </div>
  </div>

  {opinion.length > 0 && (
    <div class="opinion-strip">
      <div class="container">
        {opinion.map((p) => (
          <a href={`/news/${p.id}/`}>
            {p.data.title}
            <span>{p.data.author}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  {sections.map((s) => (
    <section class={`section ${s.theme ?? ''}`}>
      <div class="container">
        <div class="section-head">
          <h2>{s.title}</h2>
          <span class="rule"></span>
          {s.category && <a class="more" href={`/category/${s.category}/`}>আরও ›</a>}
        </div>

        {s.layout === 'split' && (
          <div class="split-1-3">
            <article class="big-story">
              <a href={`/news/${s.items[0].id}/`}>
                {s.items[0].data.image && (
                  <img
                    src={s.items[0].data.image}
                    alt={s.items[0].data.imageAlt ?? s.items[0].data.title}
                    width="700"
                    height="437"
                    loading="lazy"
                  />
                )}
                <h3>{s.items[0].data.title}</h3>
              </a>
              {s.items[0].data.dek && <p class="dek">{s.items[0].data.dek}</p>}
            </article>

            <div class="list-thumbs">
              {s.items.slice(1).map((p) => (
                <article>
                  <h4><a href={`/news/${p.id}/`}>{p.data.title}</a></h4>
                  <div class="meta-row">{catName(p.data.category)} · {bnDate(p.data.date)}</div>
                </article>
              ))}
            </div>
          </div>
        )}

        {s.layout === 'video' && (
          <div class="video-band">
            <article class="video-lead">
              <a href={`/news/${s.items[0].id}/`} style="position:relative;display:block">
                {s.items[0].data.image && (
                  <img src={s.items[0].data.image} alt={s.items[0].data.imageAlt ?? s.items[0].data.title} width="720" height="405" loading="lazy" />
                )}
                <span class="play-badge"><span>▶</span></span>
              </a>
              <h3><a href={`/news/${s.items[0].id}/`}>{s.items[0].data.title}</a></h3>
              {s.items[0].data.dek && <p class="dek">{s.items[0].data.dek}</p>}
            </article>
            <div class="video-list">
              {s.items.slice(1).map((p) => (
                <a href={`/news/${p.id}/`} class="video-row">
                  <span class="video-row__text">{p.data.title}</span>
                  {p.data.image && <img src={p.data.image} alt="" width="120" height="68" loading="lazy" />}
                </a>
              ))}
            </div>
          </div>
        )}

        {s.layout === 'shorts' && (
          <div class="shorts-row">
            {s.items.map((p) => (
              <a href={`/news/${p.id}/`} class="short-card">
                {p.data.image && <img src={p.data.image} alt="" width="168" height="298" loading="lazy" />}
                <h4>{p.data.title}</h4>
              </a>
            ))}
          </div>
        )}

        {s.layout === 'district' && (
          <>
            <div class="chips">
              {['ঢাকা', 'চট্টগ্রাম', 'রাজশাহী', 'খুলনা', 'বরিশাল', 'সিলেট', 'রংপুর', 'ময়মনসিংহ'].map((d) => (
                <a href="/category/national/">{d}</a>
              ))}
            </div>
            <div class="split-1-3">
              <article class="big-story">
                <a href={`/news/${s.items[0].id}/`}>
                  {s.items[0].data.image && (
                    <img src={s.items[0].data.image} alt={s.items[0].data.imageAlt ?? s.items[0].data.title} width="700" height="394" loading="lazy" />
                  )}
                  <h3>{s.items[0].data.title}</h3>
                </a>
                {s.items[0].data.dek && <p class="dek">{s.items[0].data.dek}</p>}
              </article>
              <div class="list-thumbs">
                {s.items.slice(1).map((p) => (
                  <article>
                    <h4><a href={`/news/${p.id}/`}>{p.data.title}</a></h4>
                    <div class="meta-row">{catName(p.data.category)} · {bnDate(p.data.date)}</div>
                  </article>
                ))}
              </div>
            </div>
          </>
        )}

        {s.layout === 'cols' && (
          <div class="cols3">
            {s.columns.map((c: any) => (
              <div class="textlist">
                <h4>{c.title}</h4>
                <ul>
                  {c.items.map((p: any) => (
                    <li><a href={`/news/${p.id}/`}>{p.data.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}

        {(s.layout === 'cards3' || s.layout === 'cards4') && (
          <div class={s.layout === 'cards3' ? 'cards3' : 'cards4'}>
            {s.items.map((p) => (
              <article>
                <a href={`/news/${p.id}/`}>
                  {p.data.image && (
                    <img src={p.data.image} alt={p.data.imageAlt ?? p.data.title} width="400" height="300" loading="lazy" />
                  )}
                  <h4>{p.data.title}</h4>
                </a>
                {p.data.dek && s.layout === 'cards3' && (
                  <p class="dek" style="font-size:14.5px;color:#555;margin:4px 0 0">{p.data.dek}</p>
                )}
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="newsletter">
    <div class="container">
      <div>
        <h2>সাপ্তাহিক সংবাদপত্র</h2>
        <p>সপ্তাহের সেরা খবর সরাসরি আপনার ইমেইলে।</p>
      </div>
      <div>
        <form action="https://formsubmit.co/hello@gazitime.online" method="POST">
          <input type="hidden" name="_subject" value="Gazitime newsletter signup" />
          <input type="hidden" name="_next" value="https://gazitime.online/?subscribed=1" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <input type="email" name="email" required placeholder="আপনার ইমেইল" aria-label="ইমেইল" />
          <button type="submit">সাবস্ক্রাইব</button>
        </form>
        <p style="font-size:12.5px;margin-top:8px">যেকোনো সময় আনসাবস্ক্রাইব করতে পারবেন।</p>
      </div>
    </div>
  </section>
</Base>
