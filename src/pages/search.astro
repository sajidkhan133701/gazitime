---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { bnDate, catName } from '../lib/utils';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const index = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  dek: p.data.dek ?? '',
  cat: catName(p.data.category),
  date: bnDate(p.data.date),
  img: p.data.image ?? '',
  body: (p.body ?? '').slice(0, 600),
}));
---

<Base title="খবর খুঁজুন" noindex={true}>
  <div class="container">
    <header class="page-head">
      <h1>খবর খুঁজুন</h1>
      <p>শিরোনাম, সেকশন বা লেখার ভেতর থেকে খুঁজুন</p>
    </header>

    <div style="padding:20px 0 40px">
      <form class="search-box" role="search" style="max-width:520px;border-radius:6px;padding:8px 14px">
        <input id="q" type="search" placeholder="যেমন: মেট্রোরেল, ক্রিকেট, বাজেট…" aria-label="খবর খুঁজুন" />
      </form>
      <p id="count" style="color:#6b7280;font-size:14px;margin-top:12px">সব খবর দেখানো হচ্ছে</p>
      <div id="results" class="cards3" style="padding-top:12px"></div>
    </div>
  </div>

  <script type="application/json" id="index" set:html={JSON.stringify(index)} />

  <script>
    const el = document.getElementById('index');
    const data = JSON.parse(el?.textContent ?? '[]');
    const q = document.getElementById('q');
    const out = document.getElementById('results');
    const count = document.getElementById('count');

    const item = (p) =>
      '<article><a href="/news/' + p.id + '/">' +
      (p.img ? '<img src="' + p.img + '" alt={p.data.title} width="400" height="300" loading="lazy">' : '') +
      '<h4>' + p.title + '</h4></a>' +
      (p.dek ? '<p style="font-size:14.5px;color:#555;margin:4px 0 0">' + p.dek + '</p>' : '') +
      '<div class="meta-row">' + p.cat + ' · ' + p.date + '</div></article>';

    const render = (term) => {
      const t = term.trim().toLowerCase();
      const hits = t
        ? data.filter((p) =>
            (p.title + ' ' + p.dek + ' ' + p.body + ' ' + p.cat).toLowerCase().includes(t)
          )
        : data;
      out.innerHTML = hits.map(item).join('');
      count.textContent = t
        ? '"' + term + '" — ' + hits.length + 'টি খবর পাওয়া গেছে'
        : 'সব খবর দেখানো হচ্ছে';
    };

    const initial = new URLSearchParams(location.search).get('q') ?? '';
    if (q) q.value = initial;
    render(initial);
    q?.addEventListener('input', (e) => render(e.target.value));
  </script>
</Base>
