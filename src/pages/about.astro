---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title="আমাদের সম্পর্কে">
  <div class="container" style="max-width:800px">
    <article class="article">
      <span class="eyebrow">পরিচিতি</span>
      <h1>আমাদের সম্পর্কে</h1>
      <div class="prose">
        <p>
          {site.name} একটি স্বাধীন অনলাইন সংবাদমাধ্যম। আমাদের লক্ষ্য নির্ভরযোগ্য সংবাদ,
          যাচাই করা তথ্য এবং স্পষ্ট বিশ্লেষণ পাঠকের কাছে পৌঁছে দেওয়া।
        </p>
        <p>
          আমরা বিশ্বাস করি সংবাদ হবে নিরপেক্ষ, এবং পাঠকের সময়ের Respect করবে। তাই আমরা
          দ্রুততার সঙ্গে নির্ভুলতাকে সমান গুরুত্ব দিই।
        </p>
        <h2>আমাদের নীতি</h2>
        <ul>
          <li>তথ্যের সূত্র যাচাই করে প্রকাশ করা</li>
          <li>ভুল হলে দ্রুত সংশোধনী দেওয়া</li>
          <li>বিজ্ঞাপন ও সম্পাদকীয় কনটেন্ট আলাদা রাখা</li>
        </ul>
        <p>
          যোগাযোগ: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </article>
  </div>
</Base>
