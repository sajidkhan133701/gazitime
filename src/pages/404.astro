---
import Base from '../layouts/Base.astro';
import { allPosts, href, img } from '../lib/feed';
import { bnDate } from '../lib/utils';

const all = await allPosts();
const picks = all.slice(0, 4);
---

<Base title="পেজটি পাওয়া যায়নি" noindex={true}>
  <section class="listing-wrap">
    <div class="container">
      <div class="text-center" style="padding: 40px 0 20px">
        <div style="font-size:64px;font-weight:700;color:var(--secondary-color);line-height:1">৪০৪</div>
        <h1 style="font-size:26px;margin:14px 0 8px">পেজটি পাওয়া যায়নি</h1>
        <p class="text-muted" style="max-width:520px;margin:0 auto 18px">
          লিংকটি হয়তো পুরনো হয়ে গেছে, নয়তো ঠিকানায় ভুল আছে। নিচের খবরগুলো পড়তে পারেন, অথবা সার্চ করুন।
        </p>
        <form action="/search/" method="get" class="d-flex justify-content-center gap-2" style="max-width:420px;margin:0 auto">
          <input class="form-control" type="search" name="q" placeholder="গাজীপুরের খবর খুঁজুন" aria-label="খুঁজুন" />
          <button class="btn btn-warning text-white" type="submit">খুঁজুন</button>
        </form>
        <p style="margin-top:18px"><a href="/" style="color:var(--secondary-color);font-weight:600">← হোমপেজে ফিরুন</a></p>
      </div>

      <div class="latest-day">সর্বশেষ খবর</div>
      <div class="row g-4 mt-2">
        {picks.map((p) => (
          <div class="col-lg-3 col-md-6 col-6">
            <article class="mini-card">
              <a href={href(p)}><img src={img(p)} alt={p.data.title} width="360" height="216" loading="lazy" /></a>
              <h3><a href={href(p)}>{p.data.title}</a></h3>
              <div class="listing-meta"><span class="listing-cat">{bnDate(p.data.date)}</span></div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
