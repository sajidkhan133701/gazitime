---
import Base from '../../layouts/Base.astro';
import areas from '../../data/areas.json';
import unions from '../../data/unions.json';
import { allPosts, href, img } from '../../lib/feed';
import { bnDate } from '../../lib/utils';

const all = await allPosts();
const gazipur = all.filter((p) => p.data.category === 'gazipur');
const bn = (n: number) => String(n).replace(/\d/g, (x) => '০১২৩৪৫৬৭৮৯'[+x]);

const countArea = (slug: string) => gazipur.filter((p) => p.data.upazila === slug).length;
const countUnion = (slug: string) => gazipur.filter((p) => (p.data as any).unionSlug === slug).length;

const withNews = areas.filter((a) => countArea(a.slug) > 0);
const totalUnions = unions.length;
const coveredUnions = unions.filter((u) => countUnion(u.slug) > 0).length;

const placeLd = {
  '@context': 'https://schema.org',
  '@type': 'AdministrativeArea',
  name: 'গাজীপুর জেলা',
  geo: { '@type': 'GeoCoordinates', latitude: 24.0, longitude: 90.42 },
  url: 'https://gazitime.online/gazipur/',
};
---

<Base
  title="গাজীপুরের এলাকা"
  seoTitle="গাজীপুরের এলাকা ভিত্তিক খবর — উপজেলা ও ইউনিয়ন | গাজী টাইম"
  description="গাজীপুর জেলার উপজেলা ও ইউনিয়নভিত্তিক সংবাদ — টঙ্গী, কালিয়াকৈর, শ্রীপুর, কাপাসিয়া, কালীগঞ্জ ও গাজীপুর সদরের স্থানীয় খবর এক জায়গায়।"
  keywords={['গাজীপুরের এলাকা', 'গাজীপুর উপজেলা', 'গাজীপুর ইউনিয়ন', 'টঙ্গী খবর', 'কালিয়াকৈর খবর']}
>
  <script type="application/ld+json" set:html={JSON.stringify(placeLd)} />

  <section class="listing-wrap">
    <div class="container">
      <nav class="crumbs" aria-label="ব্রেডক্রাম্ব">
        <a href="/">হোম</a>
        <span aria-hidden="true">›</span>
        <a href="/category/gazipur/">গাজীপুর</a>
        <span aria-hidden="true">›</span>
        <span class="crumbs__here">এলাকা</span>
      </nav>

      <div class="listing-head">
        <h1>গাজীপুরের এলাকা ভিত্তিক খবর</h1>
        <p class="listing-sub">
          জেলার ৫টি উপজেলা, {bn(totalUnions)}টি ইউনিয়ন — যেখান থেকে খবর আসছে, সেই এলাকার নামে আলাদা পেজ।
          এখন পর্যন্ত {bn(withNews.length)}টি উপজেলা ও {bn(coveredUnions)}টি ইউনিয়নের খবর প্রকাশিত।
        </p>
      </div>

      {areas.map((a) => {
        const n = countArea(a.slug);
        const us = unions.filter((u) => u.upazila === a.slug);
        return (
          <div class="area-block">
            <div class="area-block__head">
              {n > 0 ? (
                <h2><a href={`/gazipur/${a.slug}/`}>{a.name}</a></h2>
              ) : (
                <h2>{a.name}</h2>
              )}
              <span class="area-count">{n > 0 ? `${bn(n)}টি খবর` : 'খবর আসেনি এখনো'}</span>
            </div>
            <div class="area-unions">
              {us.map((u) => {
                const c = countUnion(u.slug);
                return c > 0 ? (
                  <a class="union-chip" href={`/gazipur/${a.slug}/${u.slug}/`}>{u.name}<span>{bn(c)}</span></a>
                ) : (
                  <span class="union-chip is-empty">{u.name}</span>
                );
              })}
            </div>
          </div>
        );
      })}

      <div class="listing-head mt-4"><h2 style="font-size:22px">সর্বশেষ গাজীপুরের খবর</h2></div>
      {gazipur.slice(0, 8).map((p) => (
        <article class="listing-row">
          <div class="row g-3 align-items-start">
            <div class="col-lg-9 col-8">
              <h3><a href={href(p)}>{p.data.title}</a></h3>
              <div class="listing-meta"><span class="listing-cat">{bnDate(p.data.date)}</span></div>
            </div>
            <div class="col-lg-3 col-4">
              <a href={href(p)}><img src={img(p)} alt={p.data.title} width="240" height="144" loading="lazy" /></a>
            </div>
          </div>
        </article>
      ))}

      <p class="mt-3"><a href="/category/gazipur/" style="font-weight:600;color:var(--secondary-color)">সব গাজীপুরের খবর →</a></p>
    </div>
  </section>
</Base>
