---
import Base from '../../layouts/Base.astro';
import { allPosts, href, img, catOf } from '../../lib/feed';
import { bnDate, catName } from '../../lib/utils';

export async function getStaticPaths({ paginate }: any) {
  const all = await allPosts();
  return paginate(all, { pageSize: 20 });
}

const { page } = Astro.props as any;
const posts = page.data;
const bn = (n: number) => String(n).replace(/\d/g, (x) => '০১২৩৪৫৬৭৮৯'[+x]);

const timeBn = (d: Date) =>
  new Intl.DateTimeFormat('bn-BD', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Dhaka' }).format(d);

const groups: { label: string; items: any[] }[] = [];
for (const p of posts) {
  const label = bnDate(p.data.date);
  const g = groups.find((x) => x.label === label);
  if (g) g.items.push(p);
  else groups.push({ label, items: [p] });
}
---

<Base title="সর্বশেষ" description="গাজী টাইমের সর্বশেষ সংবাদ">
  <section class="listing-wrap">
    <div class="container">
      <div class="listing-head">
        <h1>সর্বশেষ</h1>
        <p class="listing-sub">প্রকাশের সময় অনুযায়ী সাজানো — নতুন সংবাদ সবার উপরে</p>
      </div>

      {groups.map((g) => (
        <div class="latest-group">
          <div class="latest-day">{g.label}</div>
          {g.items.map((p: any) => (
            <article class="listing-row">
              <div class="row g-3 align-items-start">
                <div class="col-lg-9 col-8">
                  <div class="listing-meta">
                    <span class="listing-time">{timeBn(p.data.date)}</span>
                    <a class="listing-cat" href={`/category/${catOf(p)}/`}>{catName(catOf(p))}</a>
                  </div>
                  <h3><a href={href(p)}>{p.data.title}</a></h3>
                  {p.data.dek && <p class="listing-dek">{p.data.dek}</p>}
                </div>
                <div class="col-lg-3 col-4">
                  <a href={href(p)}><img src={img(p)} alt={p.data.title} width="220" height="132" loading="lazy" /></a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}

      <nav class="pagination-wrap" aria-label="পৃষ্ঠা">
        {page.url.prev ? <a class="page-btn" href={page.url.prev}>আগের</a> : <span class="page-btn is-off">আগের</span>}
        <span class="page-count">পৃষ্ঠা {bn(page.currentPage)} / {bn(page.lastPage)}</span>
        {page.url.next ? <a class="page-btn" href={page.url.next}>পরের</a> : <span class="page-btn is-off">পরের</span>}
      </nav>
    </div>
  </section>
</Base>
