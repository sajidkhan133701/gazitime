---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import categories from '../../data/categories.json';
import { bnDate } from '../../lib/utils';

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const all = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category === category.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [lead, ...rest] = all;
const secondary = rest.slice(0, 4);
const listing = rest.slice(4, 22);
const img = (p: any) => p.data.image ?? '/images/metro.jpg';
const href = (p: any) => `/news/${p.id}/`;
---

<Base title={category.name} description={`${category.name} — সর্বশেষ সংবাদ`}>
  <div class="container listing-wrap">
    <div class="listing-head">
      <h1>{category.name}</h1>
      <div class="listing-subnav">
        {categories.filter((c) => c.slug !== category.slug).map((c) => (
          <a href={`/category/${c.slug}/`}>{c.name}</a>
        ))}
      </div>
    </div>

    {lead && (
      <div class="row gx-4">
        <div class="col-lg-7 col-md-12">
          <article class="lead-card">
            <a href={href(lead)}><img src={img(lead)} alt={lead.data.title} width="760" height="428" /></a>
            <h2><a href={href(lead)}>{lead.data.title}</a></h2>
            {lead.data.dek && <p>{lead.data.dek}</p>}
            <small class="text-muted"><i class="fa-solid fa-clock"></i> {bnDate(lead.data.date)}</small>
          </article>
        </div>
        <div class="col-lg-5 col-md-12">
          <div class="row g-3">
            {secondary.map((p) => (
              <div class="col-lg-6 col-md-6 col-6">
                <article class="mini-card">
                  <a href={href(p)}><img src={img(p)} alt={p.data.title} width="300" height="169" /></a>
                  <h3><a href={href(p)}>{p.data.title}</a></h3>
                </article>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <div class="ad-box ad-box--970x90 my-4">বিজ্ঞাপন ৯৭০ × ৯০</div>

    <div class="listing-rows">
      {listing.map((p) => (
        <article class="listing-row">
          <div class="row gx-4 align-items-start">
            <div class="col-lg-9 col-md-8 col-7">
              <h3><a href={href(p)}>{p.data.title}</a></h3>
              {p.data.dek && <p>{p.data.dek}</p>}
              <small class="text-muted"><i class="fa-solid fa-clock"></i> {bnDate(p.data.date)}</small>
            </div>
            <div class="col-lg-3 col-md-4 col-5">
              <a href={href(p)}><img src={img(p)} alt={p.data.title} width="220" height="124" /></a>
            </div>
          </div>
        </article>
      ))}
      {listing.length === 0 && <p class="text-muted py-5">এই বিভাগে এখনো কোনো সংবাদ প্রকাশিত হয়নি।</p>}
    </div>
  </div>
</Base>
