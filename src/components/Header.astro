---
import site from '../data/site.json';
import categories from '../data/categories.json';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const nav = categories;
const today = new Intl.DateTimeFormat('bn-BD', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<div class="masthead">
  <div class="container">
    <div class="mast-side">
      <span class="mast-date">{today}</span>
      <span class="mast-links">
        <a href="/about/">ই-পেপার</a>
        <span>|</span>
        <a href="/category/special/">আর্কাইভ</a>
      </span>
    </div>

    <div class="mast-center">
      <Logo />
    </div>

    <div class="mast-side right">
      <a href={`mailto:${site.email}`} class="icon-btn" aria-label="ইমেইল">✉</a>
      <a href="/search/" class="icon-btn" aria-label="খুঁজুন">⌕</a>
    </div>
  </div>
</div>

<nav class="nav" aria-label="প্রধান মেনু">
  <div class="container">
    <div class="nav-links">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>হোম</a>
      {nav.map((c) => (
        <a href={`/category/${c.slug}/`} aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>
          {c.name}
        </a>
      ))}
    </div>
    <div class="nav-icons">
      <button class="icon-btn" aria-label="মেনু" id="mnav-btn">☰</button>
      <a href="/search/" class="icon-btn" aria-label="খুঁজুন">⌕</a>
    </div>
  </div>
</nav>

<div class="mobile-bar">
  <button class="icon-btn" aria-label="মেনু" id="mnav-btn-m">☰</button>
  <Logo size="sm" />
  <a href="/search/" class="icon-btn" aria-label="খুঁজুন">⌕</a>
</div>

<nav class="mobile-nav" id="mnav" aria-label="মোবাইল মেনু">
  <a href="/" aria-current={path === '/' ? 'page' : undefined}>হোম</a>
  {nav.map((c) => (
    <a href={`/category/${c.slug}/`} aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>
      {c.name}
    </a>
  ))}
</nav>

<script>
  const nav = document.getElementById('mnav');
  const toggle = () => {
    if (!nav) return;
    nav.style.display = nav.style.display === 'none' || !nav.style.display ? 'flex' : 'none';
  };
  document.getElementById('mnav-btn')?.addEventListener('click', toggle);
  document.getElementById('mnav-btn-m')?.addEventListener('click', toggle);
</script>
