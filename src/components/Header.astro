---
import site from '../data/site.json';
import categories from '../data/categories.json';

const path = Astro.url.pathname;
const nav = categories;
const today = new Intl.DateTimeFormat('bn-BD', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<div class="topbar">
  <div class="container">
    <span>{today}</span>
    <nav class="topbar-links" aria-label="সহায়ক">
      <a href="/about/">আমাদের সম্পর্কে</a>
      <a href="/contact/">যোগাযোগ</a>
      <a href={`mailto:${site.email}`}>বিজ্ঞাপন</a>
    </nav>
  </div>
</div>

<div class="brandrow">
  <div class="container">
    <div class="brand-side">
      <a href="/about/" style="color:var(--muted)">ই-পেপার</a>
      <span style="color:#c9c9c9"> | </span>
      <a href="/category/special/" style="color:var(--muted)">আর্কাইভ</a>
    </div>
    <div class="brand-center">
      <a class="logo" href="/">{site.name}<small>{site.tagline}</small></a>
    </div>
    <div class="brand-side right">
      <a href={`mailto:${site.email}`} class="icon-btn" aria-label="ইমেইল">✉</a>
    </div>
  </div>
</div>

<nav class="nav" aria-label="প্রধান মেনু">
  <div class="container">
    <div class="nav-links">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>হোম</a>
      {nav.map((c) => (
        <a href={`/category/${c.slug}/`} aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>
          {c.name}
        </a>
      ))}
      <a href="/search/">খবর খুঁজুন</a>
    </div>
    <div class="nav-icons">
      <a href="/search/" class="icon-btn" aria-label="খুঁজুন">⌕</a>
    </div>
  </div>
</nav>

<div class="mobile-bar">
  <button class="icon-btn" aria-label="মেনু" id="mnav-btn">☰</button>
  <a class="logo" href="/">{site.name}</a>
  <a href="/search/" class="icon-btn" aria-label="খুঁজুন">⌕</a>
</div>

<nav class="mobile-nav" id="mnav" aria-label="মোবাইল মেনু">
  <a href="/" aria-current={path === '/' ? 'page' : undefined}>হোম</a>
  {nav.map((c) => (
    <a href={`/category/${c.slug}/`} aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}>
      {c.name}
    </a>
  ))}
</nav>

<script>
  const btn = document.getElementById('mnav-btn');
  const nav = document.getElementById('mnav');
  btn?.addEventListener('click', () => {
    if (!nav) return;
    const hidden = nav.style.display === 'none';
    nav.style.display = hidden ? 'flex' : 'none';
  });
</script>
