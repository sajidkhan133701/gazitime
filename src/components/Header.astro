---
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import categories from '../data/categories.json';
import Logo from './Logo.astro';

const path = Astro.url.pathname;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const opinionPosts = posts.filter((p) => p.data.category === 'opinion').slice(0, 3);
const sliderPosts = opinionPosts.length ? opinionPosts : posts.slice(0, 3);

const today = new Intl.DateTimeFormat('bn-BD', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());

const nav = [
  { name: 'হোম', href: '/' },
  { name: 'গাজীপুর', href: '/category/gazipur/' },
  { name: 'সর্বশেষ', href: '/latest/' },
  { name: 'আজকের পত্রিকা', href: '/archive/' },
  ...categories
    .filter((c) => c.slug !== 'gazipur')
    .map((c) => ({ name: c.name, href: `/category/${c.slug}/` })),
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<section class="mobile-logo-bar d-lg-none">
  <div class="container">
    <div class="row d-flex justify-content-between align-items-center">
      <div class="col-9">
        <div class="main-logo">
          <Logo size="sm" />
        </div>
      </div>
      <div class="col-3">
        <div class="mobile-header-icons d-flex justify-content-end align-items-center">
          <button class="icon-btn theme-toggle-btn border-0 bg-transparent" aria-label="থিম">
            <i class="fa-solid fa-moon"></i>
          </button>
          <a class="icon-btn" href="/search/" aria-label="খুঁজুন"><i class="fa-solid fa-magnifying-glass"></i></a>
          <button class="icon-btn border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#megaModal" aria-label="মেনু">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="top-header d-none d-lg-block">
  <div class="container">
    <div class="row justify-content-between">
      <div class="col-lg-3 d-flex flex-column justify-content-end">
        <div class="top-dates">
          <div class="date-text"><i class="bi bi-calendar3"></i> <span id="bz-date">{today}</span></div>
          <div class="quick-links">
            <a href="/archive/">ই-পেপার</a> |<a href="/archive/"> আর্কাইভ</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 text-center my-0 my-lg-0">
        <div class="main-logo d-lg-block">
          <h1><Logo size="lg" /></h1>
        </div>
      </div>

      <div class="col-lg-3 d-lg-block">
        <div class="right-slider d-flex justify-content-end">
          <div id="headerCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-indicators">
              {sliderPosts.map((_, i) => (
                <button type="button" data-bs-target="#headerCarousel" data-bs-slide-to={i} class={i === 0 ? 'active' : ''} aria-label={`Slide ${i + 1}`} />
              ))}
            </div>
            <div class="carousel-inner hidden">
              {sliderPosts.map((p, i) => (
                <div class={`carousel-item ${i === 0 ? 'active' : ''}`}>
                  <a class="slider-image-text" href={`/news/${p.id}/`} style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:6px 0">
                    <h3 style="flex:1 1 auto;margin:0;font-size:14px;line-height:1.45;max-width:150px">{p.data.title}</h3>
                    {p.data.image && <img alt={p.data.imageAlt ?? p.data.title} width="130" height="70" class="d-block" style="position:static !important;flex:0 0 130px;width:130px;height:70px;object-fit:cover" src={p.data.image} />}
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="navbar-area sticky-top">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
      <div class="col-lg-9 col-12">
        <nav class="navbar static-top">
          <div class="custom-navbar">
            <div class="scrollable-menu" id="menuContainer">
              <ul class="api-menu d-flex list-unstyled align-items-center">
                {nav.map((n) => (
                  <li class="nav-item">
                    <a class={`nav-link-item ${isActive(n.href) ? 'active' : ''}`} href={n.href}>{n.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </nav>
      </div>

      <div class="header-actions col-lg-3 d-none d-lg-flex">
        <div class="left-tools">
          <button id="theme-toggle" class="btn theme-toggle-btn" aria-label="থিম">
            <i id="theme-icon" class="fa-solid fa-moon theme-btn theme-toggle-icon"></i>
          </button>
        </div>
        <div class="right-tools">
          <a href="https://www.facebook.com/" class="social-icon facebook" target="_blank" rel="noopener noreferrer" aria-label="ফেসবুক"><i class="fa-brands fa-facebook-f"></i></a>
          <a href="https://www.youtube.com/" class="social-icon youtube" target="_blank" rel="noopener noreferrer" aria-label="ইউটিউব"><i class="fa-brands fa-youtube"></i></a>
          <a href="https://x.com" class="social-icon twitter" target="_blank" rel="noopener noreferrer" aria-label="এক্স"><i class="fa-brands fa-x-twitter"></i></a>
        </div>
        <div class="icon-btn d-flex justify-content-center align-items-center mega-toggle" data-bs-toggle="modal" data-bs-target="#megaModal" role="button" aria-label="সব বিভাগ">
          <i class="fa-solid fa-bars"></i>
        </div>
        <div class="icon-btn d-flex justify-content-center align-items-center search-btn">
          <a href="/search/" aria-label="খুঁজুন"><i class="fa-solid fa-magnifying-glass"></i></a>
        </div>
      </div>
    </div>
  </div>

</section>

<div class="modal fade" id="megaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
      <div class="modal-content">
        <div class="modal-header">
          <div class="container">
            <div class="row d-flex justify-content-between align-items-center">
              <div class="col-10">
                <div class="barnd-logo-modal">
                  <Logo size="sm" />
                </div>
              </div>
              <div class="col-2 text-end">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="বন্ধ"></button>
              </div>
            </div>
          </div>
        </div>
        <div class="mm-body">
          <form class="mm-search" action="/search/" method="get">
            <input type="search" name="q" placeholder="গাজীপুরের খবর খুঁজুন" aria-label="খুঁজুন" />
            <button type="submit" aria-label="সার্চ"><i class="fa-solid fa-magnifying-glass"></i></button>
          </form>

          <div class="mm-quick">
            {nav.slice(0, 4).map((n) => (
              <a class="mm-chip" href={n.href}>{n.name}</a>
            ))}
          </div>

          <ul class="mm-list">
            {nav.slice(4).map((n) => (
              <li>
                <a href={n.href}>
                  {n.name}
                  <i class="fa-solid fa-angle-right"></i>
                </a>
              </li>
            ))}
          </ul>

          <div class="mm-foot">
            <a href="/latest/">সর্বশেষ</a>
            <a href="/gazipur/">এলাকা ভিত্তিক</a>
            <a href="/about/">সম্পর্কে</a>
            <a href="/contact/">যোগাযোগ</a>
          </div>
        </div>
      </div>
    </div>
  </div>

<script>
  // theme
  const root = document.documentElement;
  const saved = localStorage.getItem('gz-theme');
  if (saved) root.setAttribute('data-bs-theme', saved);
  const syncIcons = () => {
    const dark = root.getAttribute('data-bs-theme') === 'dark';
    document.querySelectorAll('.theme-toggle-btn i').forEach((i) => {
      i.classList.remove(dark ? 'fa-moon' : 'fa-sun');
      i.classList.add(dark ? 'fa-sun' : 'fa-moon');
    });
  };
  syncIcons();
  document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const dark = root.getAttribute('data-bs-theme') === 'dark';
      const next = dark ? 'light' : 'dark';
      root.setAttribute('data-bs-theme', next);
      localStorage.setItem('gz-theme', next);
      syncIcons();
    });
  });
</script>

<script is:inline>
  (function () {
    var wd = ['রবিবার','সোমবার','মঙ্গলবার','বুধবার','বৃহস্পতিবার','শুক্রবার','শনিবার'];
    var mo = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
    var bn = '০১২৩৪৫৬৭৮৯';
    function dg(n) { return String(n).replace(/\d/g, function (x) { return bn[+x]; }); }
    function render() {
      var t = new Date(Date.now() + 6 * 60 * 60 * 1000);
      var s = wd[t.getUTCDay()] + ', ' + dg(t.getUTCDate()) + ' ' + mo[t.getUTCMonth()] + ', ' + dg(t.getUTCFullYear());
      var el = document.getElementById('bz-date');
      if (el) el.textContent = s;
      var cp = document.getElementById('bz-copy');
      if (cp) cp.textContent = cp.textContent.replace(/[০-৯]{4}/, dg(t.getUTCFullYear()));
    }
    render();
    setInterval(render, 60000);
  })();
</script>
