---
import site from '../data/site.json';
import categories from '../data/categories.json';

const path = Astro.url.pathname;
const navItems = categories.slice(0, 9);
const today = new Intl.DateTimeFormat('bn-BD', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
---

<header>
  <div class="topbar">
    <div class="wrap">
      <span class="topbar-date">{today}</span>
      <nav class="topbar-links" aria-label="সহায়ক লিংক">
        <a href="/about/">আমাদের সম্পর্কে</a>
        <a href="/contact/">যোগাযোগ</a>
        <a href={`mailto:${site.email}`}>বিজ্ঞাপন</a>
      </nav>
    </div>
  </div>

  <div class="masthead">
    <div class="wrap">
      <a class="logo" href="/">{site.name}</a>
      <p class="tagline">{site.tagline}</p>

      <div class="masthead-meta">
        <span class="today">{today}</span>
        <form class="search" role="search" action="/search/" method="get">
          <input type="search" name="q" placeholder="খবর খুঁজুন…" aria-label="খবর খুঁজুন" />
          <button type="submit" aria-label="খুঁজুন" style="border:0;background:none;padding:0;color:#6b7280">
            ⌕
          </button>
        </form>
      </div>
    </div>
  </div>

  <nav class="nav" aria-label="প্রধান মেনু">
    <div class="wrap">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>প্রচ্ছদ</a>
      {navItems.map((c) => (
        <a
          href={`/category/${c.slug}/`}
          aria-current={path.startsWith(`/category/${c.slug}`) ? 'page' : undefined}
        >
          {c.name}
        </a>
      ))}
    </div>
  </nav>
</header>
