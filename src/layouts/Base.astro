---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

const {
  title,
  description = site.description,
  image = '/images/metro.jpg',
  type = 'website',
  bodyClass = '',
  slug = '',
  cat = '',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="bn" data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/vendor/media/Kalpurush.7af566a6.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="stylesheet" href="/vendor/css/nd.css" />
    <link rel="stylesheet" href="/styles/brand.css" />
    <link rel="stylesheet" href="/styles/site.css" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass} data-slug={slug} data-title={title} data-cat={cat}>
    <Header />
    <main class="home">
      <slot />
    </main>
    <Footer />
    <script src="/vendor/bootstrap.bundle.min.js" defer></script>
    <script src="/scripts/views.js" defer></script>
  </body>
</html>
